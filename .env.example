# ------------------------------------------------------------------
# FinCheck - variables de entorno
# Copia este archivo a `.env.local` y completa los valores.
# ------------------------------------------------------------------

# --- Better Auth ---------------------------------------------------
# URL base de la app (en producción, el dominio público, p. ej. https://fincheck.app)
BETTER_AUTH_URL=http://localhost:3000
# Secreto de firma de sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=genera-tu-propio-secreto-de-al-menos-32-caracteres

# --- MongoDB -------------------------------------------------------
# Local: mongodb://127.0.0.1:27017/fincheck
# Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/fincheck?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fincheck
MONGODB_DB_NAME=fincheck
# Ponlo en "true" solo si tu MongoDB corre como replica set (Atlas sí lo soporta).
MONGODB_TRANSACTIONS=false

# --- Google OAuth --------------------------------------------------
# Crea credenciales en https://console.cloud.google.com/apis/credentials
# Tipo: "ID de cliente de OAuth" -> "Aplicación web"
# URIs de redireccionamiento autorizados:
#   http://localhost:3000/api/auth/callback/google
#   https://TU-DOMINIO/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
